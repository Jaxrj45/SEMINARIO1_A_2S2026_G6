# ┌─────────────────────────────┐
# |         Base de datos       |
# └─────────────────────────────┘
DB_HOST=
DB_PORT=5432
DB_NAME=cloudcinema
DB_USER=
DB_PASSWORD=
DB_SSL=true

# ┌─────────────────────────────┐
# |          S3 Bucket          |
# └─────────────────────────────┘
AWS_REGION=us-east-1
S3_BUCKET_IMAGES=
S3_FOLDER_PROFILE=Fotos_Perfil
S3_FOLDER_MOVIES=Fotos_Peliculas

# ┌─────────────────────────────┐
# |          CORS Origin        |
# └─────────────────────────────┘
CORS_ORIGIN=

# ┌─────────────────────────────┐
# |          Server             |
# └─────────────────────────────┘
PORT=3000
SERVER_NAME=node