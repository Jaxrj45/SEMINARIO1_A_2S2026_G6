# Base de datos (RDS PostgreSQL - ver database/schema.sql y database/sps/)
DB_HOST=
DB_PORT=5432
DB_NAME=cloudcinema
DB_USER=
DB_PASSWORD=
DB_SSL=true

# S3 Bucket
AWS_REGION=us-east-1
S3_BUCKET_IMAGES=
S3_FOLDER_PROFILE=Fotos_Perfil
S3_FOLDER_MOVIES=Fotos_Peliculas

# CORS Origin (URL del bucket web estatico de Integrante A)
CORS_ORIGIN=

# Server
PORT=3000
NODE_ENV=production
