# ┌────────────────────────────────┐
# |  Base de datos (RDS Postgres)  |
# └────────────────────────────────┘
DB_HOST=
DB_PORT=5432
DB_NAME=taskflow
DB_USER=
DB_PASSWORD=
# RDS PostgreSQL exige SSL
DB_SSL=true

# ┌─────────────────────────────┐
# |             JWT             |
# └─────────────────────────────┘
JWT_SECRET=CAMBIAR_MISMO_VALOR_EN_TODOS_LOS_SERVIDORES
JWT_HOURS=8

# ┌─────────────────────────────┐
# |        Almacenamiento       |
# └─────────────────────────────┘
# aws en la EC2, azure en la VM de Azure
STORAGE_PROVIDER=aws

# AWS S3 (vacio = modo simulacion)
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Azure Blob Storage (vacio = modo simulacion)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# ┌─────────────────────────────┐
# |            Server           |
# └─────────────────────────────┘
PORT=5000
