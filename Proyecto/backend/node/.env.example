# ┌───────────────────────────────┐
# |   Base de datos (RDS MySQL)   |
# └───────────────────────────────┘
DB_HOST=
DB_PORT=3307
DB_NAME=semisocial
DB_USER=
DB_PASSWORD=

# ┌───────────────────────────────┐
# |              JWT              |
# └───────────────────────────────┘
JWT_SECRET=CAMBIAR_MISMO_VALOR_EN_LAS_DOS_EC2
JWT_HOURS=8

# ┌───────────────────────────────┐
# |              AWS              |
# └───────────────────────────────┘
# Sin llaves de acceso: la EC2 usa su rol (Semi-EC2-AppRole)
AWS_REGION=us-east-1

# ┌───────────────────────────────┐
# |            Cognito            |
# └───────────────────────────────┘
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ┌───────────────────────────────┐
# |     API Gateway (Lambdas)     |
# └───────────────────────────────┘
# URL del stage, sin / al final
UPLOAD_API=
# API key de /face/compare
FACE_API_KEY=

# ┌───────────────────────────────┐
# |         S3 (imagenes)         |
# └───────────────────────────────┘
S3_BUCKET_URL=https://semi1proyecto--g6.s3.amazonaws.com

# ┌───────────────────────────────┐
# |            Server             |
# └───────────────────────────────┘
PORT=5000
