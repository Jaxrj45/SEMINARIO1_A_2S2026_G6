{
  "POST /api/auth/register": {
    "notes": "El frontend primero sube la foto (POST {UPLOAD_API}/upload/profile) y hace signUp en Cognito; luego llama aquí con el UserSub. El backend verifica el sub con AdminGetUser antes de insertar. La contraseña se guarda en MD5.",
    "request": {
      "username": "ana",
      "fullName": "Ana López",
      "email": "ana@example.com",
      "dpi": "1234567890101",
      "password": "Secreta123!",
      "cognitoSub": "8c1e5b2a-1f3d-4e6a-9b7c-2d4f6a8b0c1e",
      "photoKey": "Fotos_Perfil/21bc-ana.jpg"
    },
    "response": {
      "201": {
        "status": "success",
        "message": "Usuario registrado. Revisa tu correo para verificar la cuenta.",
        "data": {
          "user": {
            "id": 3,
            "username": "ana",
            "fullName": "Ana López",
            "email": "ana@example.com",
            "dpi": "1234567890101",
            "photoUrl": "https://semi1proyecto-g6.s3.amazonaws.com/Fotos_Perfil/21bc-ana.jpg",
            "createdAt": "2026-10-24T15:00:00Z"
          }
        }
      },
      "409": {
        "status": "error",
        "message": "El usuario, correo o DPI ya está registrado",
        "data": { "code": "ALREADY_EXISTS" }
      },
      "400": {
        "status": "error",
        "message": "Datos inválidos",
        "data": { "code": "VALIDATION_ERROR", "fields": { "dpi": "Debe tener 13 dígitos" } }
      }
    }
  },

  "POST /api/auth/session": {
    "notes": "Login con usuario y contraseña: el frontend autentica contra Cognito y envía el idToken. El backend valida firma, emisor y audiencia con el JWKS del User Pool y emite el token propio.",
    "request": {
      "idToken": "eyJraWQiOiJ..."
    },
    "response": {
      "200": {
        "status": "success",
        "message": "Sesión iniciada",
        "data": {
          "token": "eyJhbGciOiJIUzI1NiIs...",
          "user": {
            "id": 3,
            "username": "ana",
            "fullName": "Ana López",
            "email": "ana@example.com",
            "dpi": "1234567890101",
            "photoUrl": "https://semi1proyecto-g6.s3.amazonaws.com/Fotos_Perfil/21bc-ana.jpg",
            "createdAt": "2026-10-24T15:00:00Z"
          }
        }
      },
      "401": {
        "status": "error",
        "message": "Sesión de Cognito inválida",
        "data": { "code": "UNAUTHORIZED" }
      }
    }
  },

  "POST /api/auth/face-session": {
    "notes": "Login facial: el backend busca la foto de perfil del usuario, llama a {UPLOAD_API}/face/compare y verifica en Cognito (AdminGetUser) que la cuenta esté confirmada.",
    "request": {
      "username": "ana",
      "imageBase64": "/9j/4AAQSkZJRgABAQ..."
    },
    "response": {
      "200": {
        "status": "success",
        "message": "Sesión iniciada",
        "data": {
          "token": "eyJhbGciOiJIUzI1NiIs...",
          "user": {
            "id": 3,
            "username": "ana",
            "fullName": "Ana López",
            "email": "ana@example.com",
            "dpi": "1234567890101",
            "photoUrl": "https://semi1proyecto-g6.s3.amazonaws.com/Fotos_Perfil/21bc-ana.jpg",
            "createdAt": "2026-10-24T15:00:00Z"
          }
        }
      },
      "401": {
        "status": "error",
        "message": "El rostro no coincide con la foto de perfil",
        "data": { "code": "FACE_NOT_MATCHED" }
      },
      "422": {
        "status": "error",
        "message": "No se detectó un rostro en la imagen",
        "data": { "code": "NO_FACE_DETECTED" }
      },
      "403": {
        "status": "error",
        "message": "Debes verificar tu correo antes de iniciar sesión",
        "data": { "code": "EMAIL_NOT_VERIFIED" }
      }
    }
  }
}
