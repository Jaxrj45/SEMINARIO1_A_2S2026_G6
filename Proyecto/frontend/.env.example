# Variables de entorno - Semi-Social Frontend
# Modo Mock: Si está en 'true', simula respuestas según contracts/examples sin requerir AWS ni Backend
VITE_MOCK=true

# URLs de los servicios AWS (Configurar para integración real)
# DNS del Application Load Balancer (ALB)
VITE_API_BASE=http://localhost:5000

# URL del Stage de API Gateway para carga de imágenes y Lambdas
VITE_UPLOAD_API=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# Región AWS
VITE_AWS_REGION=us-east-1

# Amazon Cognito
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Amazon Lex V2 (Bot de la facultad)
VITE_LEX_BOT_ID=xxxxxxxxxx
VITE_LEX_BOT_ALIAS_ID=xxxxxxxxxx
VITE_LEX_LOCALE_ID=es_419
